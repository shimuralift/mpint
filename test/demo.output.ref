MPint: string constructor tests

--- string constructor: decimal ---
"0"          = 0
"42"         = 42
"-17"        = -17
"+99"        = 99
"1'000'000"  = 1000000

--- string constructor: octal ---
"0"      = 0
"010"    = 8
"0755"   = 493
"-010"   = -8

--- string constructor: hexadecimal ---
"0xff"      = 255
"0xDEAD"    = 57005
"0X1A2B"    = 6699
"0xff'ee"   = 65518
"-0x10"     = -16

--- string constructor: binary ---
"0b1010"       = 10
"0B11111111"   = 255
"0b1111'1111"  = 255
"-0b11"        = -3

--- string constructor: std::string ---
std::string("12345")  = 12345
std::string("0xCAFE") = 51966

--- string constructor: arithmetic ---
"100" + "200"      = 300
"0xFF" * "2"       = 510
"0b1010" * "010"   = 80
"-0x10" + "0b10000" = 0

--- string constructor: large values fitting in long int ---
"1'000'000'000'000'000'000" = 1000000000000000000
"999'999'999'999'999'999" + 1 = 1000000000000000000

