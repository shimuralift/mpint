SRCDIR  := src
INCLDIR := include

WRAPPEDNATIVE_SRC := $(SRCDIR)/MPintWrappedNative.cpp
WRAPPEDNATIVE_HDR := $(INCLDIR)/MPint.hpp

GMP_SRC           := $(SRCDIR)/MPintGMP.cpp
GMP_HDR           := $(INCLDIR)/MPint.hpp


DEMO_DIR := demo

DEMO_SRCDIR  := $(DEMO_DIR)/src
DEMO_INCLDIR := $(DEMO_DIR)/src
DEMO_BINDIR  := $(DEMO_DIR)/bin

DEMO_SRCS := $(DEMO_SRCDIR)/demo.cpp $(DEMO_SRCDIR)/exprTest.cpp $(DEMO_SRCDIR)/det.cpp $(DEMO_SRCDIR)/redu.cpp $(DEMO_SRCDIR)/demoUtils.cpp
DEMO_HDRS := $(DEMO_INCLDIR)/det.hpp $(DEMO_INCLDIR)/redu.hpp $(DEMO_INCLDIR)/demoUtils.hpp $(DEMO_INCLDIR)/demoTypedef.hpp $(DEMO_INCLDIR)/exprTest.hpp


TARGET_NATIVE        := $(DEMO_BINDIR)/demoNative
TARGET_GMPXX         := $(DEMO_BINDIR)/demoGMPXX
TARGET_WRAPPEDNATIVE := $(DEMO_BINDIR)/demoWrappedNative
TARGET_GMP           := $(DEMO_BINDIR)/demoGMP

TARGETS := $(TARGET_NATIVE) $(TARGET_GMPXX) $(TARGET_WRAPPEDNATIVE) $(TARGET_GMP)


TEST_DIR := test

TESTOUTPUT_NATIVE        := $(TEST_DIR)/demoNative.output
TESTOUTPUT_GMPXX         := $(TEST_DIR)/demoGMPXX.output
TESTOUTPUT_WRAPPEDNATIVE := $(TEST_DIR)/demoWrappedNative.output
TESTOUTPUT_GMP           := $(TEST_DIR)/demoGMP.output

TESTOUTPUTS := $(TESTOUTPUT_NATIVE) $(TESTOUTPUT_GMPXX) $(TESTOUTPUT_WRAPPEDNATIVE) $(TESTOUTPUT_GMP)


CXX      := g++
CXXFLAGS := -std=c++14 -Wall -Wextra -pedantic -Werror -O2 -flto=auto


.PHONY: all clean

all: $(TARGETS)

clean:
	$(RM) $(TARGETS) $(TESTOUTPUTS)


$(TARGET_NATIVE): $(DEMO_SRCS) $(DEMO_HDRS)
	$(CXX) $(CXXFLAGS) -DDEMO_NATIVE -I$(DEMO_INCLDIR) -o $@ $(DEMO_SRCS)

$(TARGET_GMPXX): $(DEMO_SRCS) $(DEMO_HDRS)
	$(CXX) $(CXXFLAGS) -DDEMO_GMPXX -I$(DEMO_INCLDIR) -o $@ $(DEMO_SRCS) -lgmp -lgmpxx

$(TARGET_WRAPPEDNATIVE): $(DEMO_SRCS) $(DEMO_HDRS) $(WRAPPEDNATIVE_SRC) $(WRAPPEDNATIVE_HDR)
	$(CXX) $(CXXFLAGS) -DDEMO_WRAPPEDNATIVE -I$(DEMO_INCLDIR) -I$(INCLDIR) -o $@ $(DEMO_SRCS) $(WRAPPEDNATIVE_SRC)

$(TARGET_GMP): $(DEMO_SRCS) $(DEMO_HDRS) $(GMP_SRC) $(GMP_HDR)
	$(CXX) $(CXXFLAGS) -DDEMO_GMP -I$(DEMO_INCLDIR) -I$(INCLDIR) -o $@ $(DEMO_SRCS)  $(GMP_SRC) -lgmp
